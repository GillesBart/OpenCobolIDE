From 02264bd2292ff40a2c48f9e5bef48283d91ff230 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 10:12:49 +0000
Subject: [PATCH] Console : plus d'avertissement setPosition au relancement,
 arret du processus en cours a la fermeture

---
 open_cobol_ide/view/main_window.py | 6 ++++++
 open_cobol_ide/view/widgets.py     | 7 +++++++
 2 files changed, 13 insertions(+)

diff --git a/open_cobol_ide/view/main_window.py b/open_cobol_ide/view/main_window.py
index c5e1932..24feb47 100644
--- a/open_cobol_ide/view/main_window.py
+++ b/open_cobol_ide/view/main_window.py
@@ -70,6 +70,12 @@ class MainWindow(QtWidgets.QMainWindow):
         _logger().debug('CLOSING')
         self.ui.tabWidgetEditors.closeEvent(event)
         if event.isAccepted():
+            console = self.ui.consoleOutput
+            if console.is_running:
+                # programme ou script encore en cours : on l'arrête avant de
+                # détruire la console ("QProcess: Destroyed while process is
+                # still running")
+                console.stop_process()
             _logger().debug('CLOSED')
 
     def dragEnterEvent(self, event):
diff --git a/open_cobol_ide/view/widgets.py b/open_cobol_ide/view/widgets.py
index f6f16da..90aadec 100644
--- a/open_cobol_ide/view/widgets.py
+++ b/open_cobol_ide/view/widgets.py
@@ -199,3 +199,10 @@ class MyOutputWindow(OutputWindow):
             base_backend += '.exe'
         backend_path = os.path.join(cwd, base_backend) if hasattr(sys, 'frozen') else backend.__file__
         super(MyOutputWindow, self).__init__(parent=parent, backend=backend_path)
+
+    def clear(self):
+        super(MyOutputWindow, self).clear()
+        # le formateur garde la position du curseur d'avant l'effacement :
+        # sans cette remise à zéro Qt signale "setPosition out of range" au
+        # lancement du processus suivant
+        self._formatter._last_cursor_pos = 0
-- 
2.43.0

